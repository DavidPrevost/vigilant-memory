# Baby Monitor Backend Configuration
# Copy this to .env and update with your values

# Flask
FLASK_APP=src/app.py
FLASK_ENV=development
SECRET_KEY=change_this_to_a_random_secret_key_in_production

# Server
HOST=0.0.0.0
PORT=5000
DEBUG=True

# PostgreSQL (Primary Database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=babymonitor
POSTGRES_USER=babymonitor
POSTGRES_PASSWORD=dev_password_change_in_prod

# TimescaleDB (Time-Series Database)
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_DB=babymonitor_timeseries
TIMESCALE_USER=babymonitor
TIMESCALE_PASSWORD=dev_password_change_in_prod

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MQTT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=False

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_in_prod
MINIO_BUCKET_VIDEOS=babymonitor-videos
MINIO_BUCKET_THUMBNAILS=babymonitor-thumbnails
MINIO_SECURE=False

# Firebase Authentication
FIREBASE_CREDENTIALS_PATH=./config/firebase-credentials.json
FIREBASE_PROJECT_ID=your-project-id

# Security
JWT_SECRET_KEY=change_this_jwt_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Video Settings
MAX_VIDEO_SIZE_MB=500
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,mkv
VIDEO_RETENTION_DAYS_FREE=7
VIDEO_RETENTION_DAYS_PAID=30

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100 per hour

# Monitoring
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/backend.log
